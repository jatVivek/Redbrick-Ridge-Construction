# ─── Server ───────────────────────────────────────────────
PORT=3001

# ─── JWT ──────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')|console.log"
JWT_SECRET=change_this_to_a_long_random_string

# ─── Owner PIN ────────────────────────────────────────────
# This is the bcrypt hash of "2468" (cost factor 12).
# To generate a new hash: node -e "const b=require('bcryptjs');b.hash('YOUR_PIN',12).then(console.log)"
OWNER_PIN_HASH=$2a$12$xbW8RdGyU0S.B1GzfThy/uJnpRjVCTdjvDbCpmGowQH9UFv2qc8Vm

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CORS_ORIGIN=http://localhost:3000
